{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/agents/*": ["./src/agents/*"],
      "@/rag/*": ["./src/rag/*"],
      "@/cache/*": ["./src/cache/*"],
      "@/chat/*": ["./src/chat/*"],
      "@/llm/*": ["./src/llm/*"],
      "@/database/*": ["./src/database/*"],
      "@/config/*": ["./src/config/*"],
      "@/routes/*": ["./src/routes/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "web", "scripts/**/*"]
}
