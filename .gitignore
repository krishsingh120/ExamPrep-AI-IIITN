# Dependencies
node_modules/
web/node_modules/

# Build output
dist/
build/
web/dist/
web/build/
*.js.map

# Environment — NEVER commit secrets
.env
.env.local
.env.*.local
.env.production

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Local database data (if running locally outside docker)
data/
mongo-data/
redis-data/
qdrant-data/

# Coverage
coverage/
.nyc_output/

# Editor
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
tmp/
temp/

# Scripts output
scripts/output/

# Document files (large binaries — add your own locally)
docs/**/*.pdf
docs/**/*.pptx
docs/**/*.ppt
docs/**/*.docx
# Keep directory structure
!docs/**/.gitkeep
!docs/**/README.md
