PORT=3001
NODE_ENV=development

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Get your Groq API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use — llama-3.3-70b-versatile is recommended
GROQ_MODEL=llama-3.3-70b-versatile

# ─── LangSmith Tracing ────────────────────────────────────────────────────────
# Get your LangSmith API key at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=examprep-ai

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local (docker): redis://localhost:6379
# Upstash (cloud free tier): rediss://:password@host:port
REDIS_URL=redis://localhost:6379

# Cache TTL in seconds
CACHE_TTL_ANSWERS=3600
CACHE_TTL_WEIGHTAGE=86400
CACHE_TTL_PREDICTIONS=86400

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local (docker): mongodb://localhost:27017/examprep-ai
# Atlas (cloud free tier): mongodb+srv://user:pass@cluster.mongodb.net/examprep-ai
MONGODB_URI=mongodb://localhost:27017/examprep-ai

# ─── Qdrant ──────────────────────────────────────────────────────────────────
# Local (docker): http://localhost:6333
# Qdrant Cloud (free tier): https://your-cluster.qdrant.io
QDRANT_URL=http://localhost:6333

# Optional: only required for Qdrant Cloud
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

QDRANT_COLLECTION=examprep_docs

# ─── App Config ──────────────────────────────────────────────────────────────
# Comma-separated list of subjects available in this deployment
SUBJECTS=DBMS,CN,OS,DSA,TOC,CD

# Top-K documents to retrieve from Qdrant per query
RAG_TOP_K=5
